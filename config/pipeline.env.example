# Reference for the CI/CD variables this pipeline expects. Add these under
# your GitLab project's Settings > CI/CD > Variables - do NOT commit real
# secrets here. Mark every credential as Masked and Protected, and scope
# them to the protected branch/environment you run upgrades from.

# --- Firmware source: S3 (recommended default - see docs/PIPELINE.md) ---
FIRMWARE_SOURCE=s3
S3_BUCKET=my-netscaler-firmware-bucket
S3_FIRMWARE_KEY=sdx/build-13.1-build.tgz
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- Firmware source: Windows/SMB share (use if runners have no path to S3) ---
# FIRMWARE_SOURCE=smb
# SMB_SHARE_HOST=fileserver.corp.example.com
# SMB_SHARE_NAME=firmware
# SMB_FIRMWARE_PATH=netscaler/build-13.1-build.tgz
# SMB_SHARE_USER=svc-netscaler-ci
# SMB_SHARE_PASSWORD=
# SMB_SHARE_DOMAIN=CORP

# Known-good checksum for the build being deployed this run (from the
# vendor download page or your own release manifest). Strongly recommended.
EXPECTED_SHA256=

# --- Device credentials ---
NS_SSH_USER=nsroot
# Prefer a key over a password - add NS_SSH_PRIVATE_KEY_FILE as a GitLab
# "File" type CI/CD variable containing the private key.
# NS_SSH_PASSWORD=

# Only required for the SDX SVM NITRO upgrade trigger:
NS_SVM_USERNAME=nsroot
NS_SVM_PASSWORD=

# SNMP community used for the SDX power-supply health check
SNMP_COMMUNITY=public
